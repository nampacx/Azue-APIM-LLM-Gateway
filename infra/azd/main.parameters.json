{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "publisherEmail": { "value": "${HEIMDAL_PUBLISHER_EMAIL}" },
    "enableMai": { "value": "${HEIMDAL_ENABLE_MAI=false}" },
    "mcpKey": { "value": "${HEIMDAL_MCP_KEY=}" },
    "enableOllama": { "value": "${HEIMDAL_ENABLE_OLLAMA=false}" },
    "ollamaUrl": { "value": "${HEIMDAL_OLLAMA_URL=}" },
    "ollamaModels": { "value": "${HEIMDAL_OLLAMA_MODELS=}" },
    "ollamaAuth": { "value": "${HEIMDAL_OLLAMA_AUTH=}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID=}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" }
  }
}
